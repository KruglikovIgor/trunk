<?xml version="1.0" encoding="utf-8" ?>
<KPK2HardwareSettings>
  
  <!-- ИП постоянного тока -->
  <DCPS>
    <port PortName ="COM2" BaudRate="9600" Parity="None" StopBits="One" DataBits="8" ReadTimeout="300" WriteTimeout="100"/>
  </DCPS>
    
  <!-- ИП переменного тока -->
  <ACPS>
    <port PortName ="COM8" BaudRate="9600" Parity="None" StopBits="One" DataBits="8" ReadTimeout="300" WriteTimeout="100"/>
  </ACPS>

  <LanACPS>
    <lanport IPAddress="172.16.51.10"/>
  </LanACPS> 
  
  <!-- Контрольная задача -->
  <KZ>
  <port PortName ="COM6" BaudRate="9600" Parity="None" StopBits="One" DataBits="8" ReadTimeout="300" WriteTimeout="100"/>
  </KZ>
  
  <!-- Генератор -->
  <SKT>
    <port  PortName ="COM3" BaudRate="9600" Parity="None" StopBits="One" DataBits="8" ReadTimeout="300" WriteTimeout="100"/>
  </SKT>
  
  <!-- Дискретные входы -->
  <DInputs>
  <port PortName ="COM5" BaudRate="9600" Parity="None" StopBits="One" DataBits="8" ReadTimeout="300" WriteTimeout="100"/>
  </DInputs>
  
  <!-- Дискретные выходы -->
  <DOutputs>
  <port PortName ="COM4" BaudRate="9600" Parity="None" StopBits="One" DataBits="8" ReadTimeout="300" WriteTimeout="100"/>
  </DOutputs>

  <!-- Плата ацп и ее модули -->
  <LTRUnits>
    <LTRUnit name ="LTR114" address="11"></LTRUnit>
    <LTRUnit name="LTR11_1" address ="12"></LTRUnit>
    <LTRUnit name="LTR11_2" address ="13"></LTRUnit>
    <LTRUnit name="LTR11_3" address ="14"></LTRUnit>
    <LTRUnit name="LTR22_1" address="15"></LTRUnit>
    <LTRUnit name="LTR22_2" address="16"></LTRUnit>
  </LTRUnits>
  
  <!--
  <ADV name="adv1760" address=0></ADV> - не используются из бд?-->
  
</KPK2HardwareSettings>