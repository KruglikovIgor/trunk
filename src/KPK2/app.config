<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <configSections>
        <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
            <section name="KPK2.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
        </sectionGroup>
        <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
            <section name="KPK2.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
        </sectionGroup>
      <section name="KPK2HardwareSettings" type="Sparc.KPK2.Config.Hardware.KPK2HardwareSettings, Sparc.KPK2.Config" />
    </configSections>
  <KPK2HardwareSettings configSource="KPK2Hardware.config" />
    <connectionStrings>
        <add name="KPK2.Properties.Settings.DbDiss15_32ConnectionString"
            connectionString="Data Source=.\sqlexpress;Initial Catalog=KPK2;Integrated Security=True"
            providerName="System.Data.SqlClient" />
    </connectionStrings>
    <applicationSettings>
        <KPK2.Properties.Settings>
            <setting name="TestVersion" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="IsInverseAngeForDISS15CT4" serializeAs="String">
                <value>False</value>
            </setting>
        </KPK2.Properties.Settings>
    </applicationSettings>
    <userSettings>
        <KPK2.Properties.Settings>
            <setting name="LCardsDllPath" serializeAs="String">
                <value>LCards.dll</value>
            </setting>
            <setting name="VoltmeterHelloString" serializeAs="String">
                <value>Hello! KPK2 get this voltmeter!</value>
            </setting>
            <setting name="SelfTest" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="UniqueProgramText" serializeAs="String">
                <value>The КПК-2 application is already running!</value>
            </setting>
            <setting name="ShowLanguage" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="Password_Attestation" serializeAs="String">
                <value>123123</value>
            </setting>
            <setting name="FirstRun" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="PS115COMPort" serializeAs="String">
                <value />
            </setting>
            <setting name="DBConnectionStr" serializeAs="String">
                <value />
            </setting>
            <setting name="JUPEnable" serializeAs="String">
                <value>False</value>
            </setting>
        </KPK2.Properties.Settings>
    </userSettings>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0" />
  </startup>
	<runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
			<dependentAssembly>
				<assemblyIdentity name="Ivi.Visa.Interop" publicKeyToken="A128C98F1D7717C1" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-5.0.0.0" newVersion="5.0.0.0" />
			</dependentAssembly>
		  <dependentAssembly>
        <assemblyIdentity name="NLog" publicKeyToken="5120e14c03d0593c" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-5.0.0.0" newVersion="5.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
	</runtime>
</configuration>
