<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" throwExceptions="false">

  <variable name="logDirectory" value="${specialfolder:folder=CommonDocuments}/Sparc/KPK2/Logs"/>

  <targets>
    <target
      name="infLog"
      xsi:type="File"
      encoding="utf-16"
      fileName="${logDirectory}/Info_KPK2.log"
      archiveAboveSize="2048576"
      keepFileOpen="true"
      layout="[${level}]:[${date:format=dd.MM.yyyy HH\:mm\:ss.fff}]:[${callsite:className=true:fileName=false:includeSourcePath=true
          :methodName=true:cleanNamesOfAnonymousDelegates=false}]:${message} ${exception:format=tostring}" />

    <target
    name="errLog"
    xsi:type="File"
    encoding="utf-16"
    fileName="${logDirectory}/Error_KPK2.log"
    archiveAboveSize="2048576"
    keepFileOpen="true"
    layout="[${level}]:[${date:format=dd.MM.yyyy HH\:mm\:ss.fff}]:[${callsite:className=true:fileName=false:includeSourcePath=true
          :methodName=true:cleanNamesOfAnonymousDelegates=false}]:${message} ${exception:format=tostring}" />

  <target
    name="traceLog"
    xsi:type="File"
    encoding="utf-16"
    fileName="${logDirectory}/Trace_KPK2.log"
    archiveAboveSize="2048576"
    keepFileOpen="true"
    layout="[${level}]:[${date:format=dd.MM.yyyy HH\:mm\:ss.fff}]:[${callsite:className=true:fileName=false:includeSourcePath=true
          :methodName=true:cleanNamesOfAnonymousDelegates=false}]:${message} ${exception:format=tostring}" />
  </targets>
  
  <rules>
    <logger name="*" minlevel="Info" maxlevel="Info" writeTo="infLog"/>
    <logger name="*" minlevel="Error" maxlevel="Fatal" writeTo="errLog"/>
    <logger name="*" minlevel="Trace" maxlevel="Debug" writeTo="traceLog"/>
  </rules>
</nlog>