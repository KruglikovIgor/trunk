      <ProductName>SQL Server 2008 Express</ProductName>
    </BootstrapperFile>
    <BootstrapperFile Include="Microsoft.Windows.Installer.3.1">
      <ProductName>Windows Installer 3.1</ProductName>
    </BootstrapperFile>
    <BootstrapperFile Include="SAP.CrystalReports14.NET.2.0">
      <ProductName>SAP Crystal Reports Runtime Engine for .NET Framework</ProductName>
    </BootstrapperFile>
    <BootstrapperFile Include="Microsoft.Data.Access.Components.2.8">
      <ProductName>Microsoft Data Access Components 2.8</ProductName>
