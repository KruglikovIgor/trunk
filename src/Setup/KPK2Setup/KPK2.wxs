<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <?include Version.wxi?>

  <?define ProductName="KPK2" ?>
  <?define Manufacturer="SPARC"?>
  <?define LibPath="..\..\lib\"?>
  <?define ResourcesPath="..\..\KPK2\"?>
  
	<Product Id="*" Name="$(var.ProductName)" Language="1033" Version="$(var.ProductVersion)" Manufacturer="$(var.Manufacturer)" UpgradeCode="7b66010a-22cf-42c3-b95c-d30069056453">
		<Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine" Description="!(loc.PackageDescription) $(var.ProductVersion)" SummaryCodepage="!(loc.ProductPackageLanguage)"/>

		<MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
		<MediaTemplate EmbedCab="yes" />    

    <Icon Id="icon.ico" SourceFile="$(var.ResourcesPath)\Todo.ico"/>
    <Property Id="ARPPRODUCTICON" Value="icon.ico" />

    <Feature Id="Feature.ReportGenerator"
             Title="!(loc.KPK2.ReportGenerator)"
             Description="!(loc.KPK2.ReportGeneratorDescription)"
             Level="1"
    >

      <ComponentGroupRef Id="Cmp.ReportGenerator.Files"/>
      
      <ComponentGroupRef Id="Cmp.ReportGenerator.Config"/>

      <ComponentRef Id="Cmp.Kpk2ReportGenerator.Shortcuts.Desktop"/>

    </Feature>

		<Feature Id="ProductFeature" Title="KPK2Setup" Level="1">
			<ComponentGroupRef Id="KPK2Components" />
      <ComponentGroupRef Id="KPK2Manual" />
      <ComponentGroupRef Id="KPK2LibComponents" />
      <ComponentGroupRef Id="KPK2EnLocalization" />
      <ComponentGroupRef Id="KPK2RuLocalization" />
      <ComponentGroupRef Id="KPK2EsLocalization" />
      <ComponentGroupRef Id="KPK2MainMenuShortcuts" />
      <ComponentGroupRef Id="KPK2DesktopShortcuts" />
      <ComponentGroupRef Id="KPK2Database" />
      <ComponentGroupRef Id="KPK2DatabaseInstaller" />
    </Feature>

    <PropertyRef Id="NETFRAMEWORK20"/>
    <Condition Message="Install Framework 2.0!">
      <![CDATA[Installed OR NETFRAMEWORK20]]>
    </Condition>

    <PropertyRef Id="NETFRAMEWORK40FULL"/>
    <Condition Message="Install Framework 4.0!">
      <![CDATA[Installed OR NETFRAMEWORK40FULL]]>
    </Condition>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="ManufacturerFolder" Name ="$(var.Manufacturer)">
          <Directory Id="KPK2Location" Name="$(var.ProductName)">
            <Directory Id="KPK2En" Name="en" />
            <Directory Id="KPK2Ru" Name="ru" />
            <Directory Id="KPK2Es" Name="es" />
            <Directory Id="ReportGenerator" Name="ReportGenerator"/>
            <Directory Id="Database" Name="Database" />
          </Directory>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="MenuManufacturerFolder" Name="$(var.Manufacturer)">
          <Directory Id ="MenuKPK2Folder" Name="$(var.ProductName)"/>
        </Directory>
      </Directory>
      <Directory Id="CommonAppDataFolder">
        <Directory Id="CommonManufacturerFolder" Name="$(var.Manufacturer)">
          <Directory Id="CommonKPK2Folder" Name="$(var.ProductName)"/>
        </Directory>
      </Directory>
      <Directory Id="DesktopFolder"/>
    </Directory>

    <ComponentGroup Id="KPK2DatabaseInstaller" Directory="KPK2Location">
		<Component Id="DBInstallerGUI" Guid="AC1CF244-8951-4460-95CB-39EFF910BFDE">
			<File Source="$(var.DBInstallerGUI.TargetDir)\DBInstallerGUI.exe" Checksum="yes"
			      KeyPath="yes" />
      </Component>
	    <Component Id="DatabaseInstaller" Guid="9AFCD8D7-7534-47EC-9920-4A28A4A8AA7E">
		    <File Source="$(var.DatabaseInstaller.TargetDir)\DatabaseInstaller.dll" Checksum="yes"
		          KeyPath="yes" />
	    </Component>
	    <Component Id="DBConfiguration" Guid="9087862C-0433-428E-93C1-89F01536A7F1">
		    <File Source="$(var.DBConfiguration.TargetDir)\DBConfiguration.dll" Checksum="yes"
		          KeyPath="yes" />
	    </Component>
	    <Component Id="DBInstaller.Interface" Guid="C8FEA145-B83B-40FB-B7FA-7E21D1241C93">
		    <File Source="$(var.DBInstaller.Interface.TargetDir)\DBInstaller.Interface.dll" Checksum="yes"
		          KeyPath="yes" />
	    </Component>
	    <Component Id="MefContrib" Guid="3DBBD042-3B46-4B0B-9DC1-BD72FB8DD498">
		    <File Source="$(var.DBInstallerGUI.TargetDir)\MefContrib.dll" Checksum="yes"
		          KeyPath="yes" />
	    </Component>
	    <Component Id="MefContrib.Integration.Unity" Guid="D86B9C41-BF92-4F32-BB92-618A9607CAA7">
		    <File Source="$(var.DBInstallerGUI.TargetDir)\MefContrib.Integration.Unity.dll" Checksum="yes"
		          KeyPath="yes" />
	    </Component>
	    <Component Id="Microsoft.Practices.ServiceLocation" Guid="76DD148A-67DE-4E9B-898D-0EA22DA8AF88">
		    <File Source="$(var.DBInstallerGUI.TargetDir)\Microsoft.Practices.ServiceLocation.dll" Checksum="yes"
		          KeyPath="yes" />
	    </Component>
	    <Component Id="Microsoft.Practices.Unity.Configuration" Guid="5A555121-7885-4244-B60D-AF53E0084D08">
		    <File Source="$(var.DBInstallerGUI.TargetDir)\Microsoft.Practices.Unity.Configuration.dll" Checksum="yes"
		          KeyPath="yes" />
	    </Component>
	    <Component Id="Microsoft.Practices.Unity" Guid="D3C57D7F-4294-464A-86D7-73DC272C86E3">
		    <File Source="$(var.DBInstallerGUI.TargetDir)\Microsoft.Practices.Unity.dll" Checksum="yes"
		          KeyPath="yes" />
	    </Component>
    </ComponentGroup>

 
    <ComponentGroup Id="Cmp.ReportGenerator.Config" Directory="ReportGenerator">
      <Component Id="LogPath.xml" Guid="F22CB7FD-F987-465A-AD5E-CAB92814A64B">
        <File Id="FILE_LogPath" KeyPath="yes" Source="$(var.SolutionDir)..\lib\LogPath.xml" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="Cmp.ReportGenerator.Files" Directory="ReportGenerator">
      <Component Id="Sparc.Utils.GenerateSoftwareReport.exe" Guid="79BE7F28-C8B5-4D33-B36C-B0FE66E7AB25">
        <File Id="FILE_Sparc.Utils.GenerateSoftwareReport" KeyPath="yes" Source="$(var.SolutionDir)..\lib\ReportGenerator\Sparc.Utils.GenerateSoftwareReport.exe" />
      </Component>

      <Component Id="ICSharpCode.SharpZipLib.dll" Guid="6457BDDF-BF17-42FF-8F7B-D54E29998080">
        <File Id="FILE_ICSharpCode.SharpZipLib" KeyPath="yes" Source="$(var.SolutionDir)..\lib\ReportGenerator\ICSharpCode.SharpZipLib.dll"/>
      </Component>

      
    </ComponentGroup>

    <ComponentGroup Id="KPK2Components" Directory="KPK2Location">
      <Component Id="CMP_AktorPS" Guid="0BBE923B-AAC9-4598-A6F2-AA682355C97C">
        <File Id="FILE_AktorPS" KeyPath="yes" Source="$(var.FilesPath)\AktorPS115v.dll" />        
      </Component>            
      <Component Id="CMP_APS1102" Guid="04D324AF-FF0B-40A6-BF70-2CE341E98652">
