      </Component>
      <Component Id="CMP_KPK2EXE" Guid="B722C416-FB7B-437F-87E0-E646B1A3EF29">
        <File Id="FILE_KPK2EXE" KeyPath="yes" Source="$(var.FilesPath)\KPK2.exe"/>
      </Component>
      <Component Id="CMP_KPK2Config" Guid="5DE7E700-637C-46CB-8D2B-A993C61B5488">
        <File Id="FILE_KPK2Config" KeyPath="yes" Source="$(var.FilesPath)\KPK2.exe.config" />
      </Component>
      <Component Id="CMP_ZedGraph" Guid="54470DC1-3F84-4AF7-8CBE-9D6F458D762B">
