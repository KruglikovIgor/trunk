<?xml version="1.0" encoding="utf-8"?>

<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <targets>
    <target
      name="LogFile"
      xsi:type="File"
      encoding="utf-8"
      fileName="${specialFolder:folder=ApplicationData}/Sparc/KPK-6/Logs/${logger}.log"
      keepFileOpen="true"
      layout="${time}  ${message}"
      />
  </targets>

  <rules>
    <logger name="*" writeTo="LogFile" />
  </rules>

</nlog>