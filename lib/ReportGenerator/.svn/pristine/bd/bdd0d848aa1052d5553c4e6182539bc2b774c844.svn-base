        <member name="M:Sparc.Utils.GenerateSoftwareReport.WorkWithReport.Compress(System.String,System.String,System.String,System.Boolean)">
            <summary>
            Сжатие каталога или файла в архив
            </summary>
            <param name="startPath">Путь до элемента, который будет помещён в архив</param>
            <param name="zipPath">Путь до места архива</param>
            <param name="kpkName">Имя КПК используется при формировании имени выходного файла</param>
            <param name="replace">Заменять ли текущий файл, если он уже создан ранее</param>
            <returns> Возвращает пути сохранённых архивов </returns>
        </member>
        <member name="M:Sparc.Utils.GenerateSoftwareReport.WorkWithReport.CopyAll(System.String,System.String)">
